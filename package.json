{
  "name": "okhsl",
  "version": "0.2.0",
  "type": "module",
  "description": "Dependency-free OkHSL and sRGB conversion with hex, CSS, integer, byte and HSL helpers",
  "keywords": [
    "color",
    "okhsl",
    "oklab",
    "srgb",
    "hsl"
  ],
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/okhsl.git"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "bun build src/main.ts --target browser --production --outfile dist/main.js && tsc --project tsconfig.build.json",
    "lint": "bunx --bun eslint . --max-warnings 0",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "bundil": "0.1.0",
    "eslint": "10.15.0",
    "eslint-config-jaid": "37.1.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@types/bun": "1.4.5"
  },
  "files": [
    "dist/main.js",
    "dist/main.d.ts",
    "license.txt",
    "readme.md"
  ],
  "packageManager": "bun@1.4.5",
  "sideEffects": false
}
